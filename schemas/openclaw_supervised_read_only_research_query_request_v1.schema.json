{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openclaw_supervised_read_only_research_query_request_v1.schema.json",
  "title": "OpenClaw Supervised Read-Only Research Query Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_request_schema_version",
    "request_id",
    "query_id",
    "human_review_required"
  ],
  "properties": {
    "query_request_schema_version": {
      "const": "OPENCLAW_SUPERVISED_READ_ONLY_RESEARCH_QUERY_REQUEST_V1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 128
    },
    "query_id": {
      "type": "string",
      "enum": [
        "PROJECT_COMPLETION_STATUS",
        "LONG_RESEARCH_STATUS",
        "SHORT_RESEARCH_STATUS",
        "EVIDENCE_DATASET_STATUS",
        "RESEARCH_LOCK_STATUS",
        "OPERATIONAL_PERMISSION_STATUS"
      ]
    },
    "human_review_required": {
      "const": true
    }
  }
}
