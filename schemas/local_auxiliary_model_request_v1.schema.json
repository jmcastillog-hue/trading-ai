{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local_auxiliary_model_request_v1.schema.json",
  "title": "Local Auxiliary Model Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_type",
    "payload",
    "max_output_tokens",
    "human_review_required",
    "allow_external_action",
    "allow_actionable_trading_fields"
  ],
  "properties": {
    "task_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "payload": {
      "type": "object"
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 64,
      "maximum": 160
    },
    "human_review_required": {
      "const": true
    },
    "allow_external_action": {
      "const": false
    },
    "allow_actionable_trading_fields": {
      "const": false
    }
  }
}
